{
  "name": "@clipzi/cli",
  "version": "0.1.1",
  "description": "Turn long videos into finished short clips from your terminal or your AI agent. The Clipzi command line: upload a video, let Clipzi find the moments, frame them for vertical, caption them and hand you the mp4s.",
  "type": "module",
  "bin": {
    "clipzi": "bin/clipzi.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "manifest.json",
    "icon.png"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:desktop": "npx -y @anthropic-ai/mcpb pack . clipzi.mcpb"
  },
  "keywords": [
    "clipzi",
    "video",
    "clips",
    "shorts",
    "reels",
    "tiktok",
    "podcast",
    "mcp",
    "agent",
    "cli",
    "claude",
    "skill"
  ],
  "homepage": "https://clipzi.app/en/mcp",
